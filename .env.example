# Any OpenAI-compatible endpoint. Default is local Ollama.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:3b
LLM_API_KEY=ollama
LLM_TIMEOUT_MS=120000

# Where the database and documents live. Relative to this folder.
DATA_DIR=data

PORT=8787

# macOS only: timed reminders are also added to Apple's Reminders app, so they go off
# when the assistant is closed and on your iPhone. Set to off to keep them inside the assistant.
# SYSTEM_REMINDERS=on

# Voice input (whisper.cpp). Defaults work after: npm run setup:voice
# WHISPER_BIN=whisper-cli
# WHISPER_MODEL=models/ggml-base.en.bin
